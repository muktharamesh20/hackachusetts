# Expo reads EXPO_PUBLIC_* vars at build time and inlines them into the app.
# Copy to .env and fill in. Use the ANON key here (safe for client use with RLS).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Sign-In (optional). iOS OAuth client for bundle com.muktha.pantrysort.
# The web client ID is only required on Android.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
