{
  "expo": {
    "name": "PantrySort",
    "slug": "pantrysort",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pantrysort",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f766e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muktha.pantrysort",
      "appleTeamId": "MNV5NQY9WU"
    },
    "android": {
      "package": "com.muktha.pantrysort",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/withIosPodDeploymentTarget"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
