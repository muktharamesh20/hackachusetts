{
  "expo": {
    "name": "PantrySort",
    "slug": "pantrysort",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pantrysort",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muktha.pantrysort",
      "appleTeamId": "MNV5NQY9WU",
      "infoPlist": {
        "CFBundleDisplayName": "Stash"
      }
    },
    "android": {
      "package": "com.muktha.pantrysort",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "./plugins/withIosPodDeploymentTarget",
      [
        "expo-camera",
        {
          "cameraPermission": "Stash uses the camera to scan QR labels and barcodes when you log items into your pantry.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stash uses your location to show food pantries near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/hazel-wave.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FBF5EA"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/images/app-icon.png"
  }
}
