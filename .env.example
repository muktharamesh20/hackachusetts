# Copy to .env and adjust. Loaded by pantrysort.config.

# --- Simulation ---
PANTRYSORT_SIM_TIME_STEP=0.001        # Drake MultibodyPlant discrete time step (s)
PANTRYSORT_SIM_REALTIME_RATE=1.0      # 0 = as fast as possible
PANTRYSORT_MESHCAT=true               # Launch Meshcat visualizer
PANTRYSORT_QR_SCANNER=true            # Identify items by rendering + decoding their QR stickers

# --- Policy ---
PANTRYSORT_POLICY_BACKEND=scripted    # scripted | lerobot
PANTRYSORT_LEROBOT_POLICY_PATH=       # Local path or HF hub id of a trained policy
PANTRYSORT_DEVICE=cpu                 # cpu | cuda | mps

# --- Inventory ---
PANTRYSORT_INVENTORY_BACKEND=memory   # memory | supabase
PANTRYSORT_EXPIRY_WARN_DAYS=14        # Flag items expiring within N days

# --- Supabase (only needed when PANTRYSORT_INVENTORY_BACKEND=supabase) ---
# Project Settings -> API in your Supabase dashboard.
SUPABASE_URL=                         # https://<project-ref>.supabase.co
SUPABASE_KEY=                         # anon public key (client/app use)
# SUPABASE_SERVICE_ROLE_KEY=          # service_role key (server-side only; bypasses RLS)

# --- Logging ---
PANTRYSORT_LOG_LEVEL=INFO
